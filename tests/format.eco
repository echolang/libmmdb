/**
 * The format itself: every data type through the decoder test database, and
 * every record size in IPv4, IPv6 and mixed trees.
 */

use mmdb::{Database, Found, Entry, Kind};

#[group: "decoder"]
test decoder_every_type
{
    $d = db('MaxMind-DB-test-decoder');
    Found $f = guard $d->lookup(mapped(1, 1, 1, 0));
    Entry $r = $f->entry;

    assert($r->get('array')->kind() == Kind::list);
    assert($r->get('array')->count() == 3);
    assert(($r->get('array')->at(2)->asUint() ?? 0) == 3);
    assert(($r->get('boolean')->asBool() ?? false));
    assert(($r->get('double')->asFloat() ?? 0.0) == 42.123456);
    assert($r->get('float')->kind() == Kind::f32);
    assert((($r->get('float')->asFloat() ?? 0.0) as float32) == 1.1f);
    assert(($r->get('int32')->asInt() ?? 0) == -268435456);
    assert(($r->get('uint16')->asUint() ?? 0) == 100);
    assert(($r->get('uint32')->asUint() ?? 0) == 268435456);
    assert(($r->get('uint64')->asUint() ?? 0) == 1152921504606846976);
    assert(($r->get('utf8_string')->asStr() ?? '') == 'unicode! ☯ - ♫');
    assert(($r->get('map')->get('mapX')->get('utf8_stringX')->asStr() ?? '') == 'hello');
    assert(($r->get('map')->get('mapX')->get('arrayX')->at(1)->asUint() ?? 0) == 8);

    string $bytes = guard $r->get('bytes')->asBytes();

    assert($bytes->size() == 4);
    assert($bytes->byte(3) == 42);

    // 2^120 does not fit 64 bits, so only the raw bytes read it
    assert($r->get('uint128')->asUint() == null);

    string $big = guard $r->get('uint128')->asBytes();

    assert($big->size() == 16);
    assert($big->byte(0) == 1);
}

#[group: "decoder"]
test decoder_zero_values
{
    $d = db('MaxMind-DB-test-decoder');
    Found $f = guard $d->lookup(mapped(0, 0, 0, 0));
    Entry $r = $f->entry;

    assert($r->get('array')->count() == 0);
    assert(!($r->get('boolean')->asBool() ?? true));
    assert(($r->get('int32')->asInt() ?? 1) == 0);
    assert(($r->get('uint64')->asUint() ?? 1) == 0);
    assert(($r->get('utf8_string')->asStr() ?? 'x') == '');
    assert(($r->get('uint128')->asUint() ?? 1) == 0);
}

#[group: "decoder"]
test decoder_max_values
{
    $d = db('MaxMind-DB-test-decoder');
    Found $f = guard $d->lookup(mapped(255, 255, 255, 255));
    Entry $r = $f->entry;

    assert(($r->get('uint16')->asUint() ?? 0) == 65535);
    assert(($r->get('uint32')->asUint() ?? 0) == 4294967295);
    assert(($r->get('uint64')->asUint() ?? 0) == 18446744073709551615);
    assert(($r->get('int32')->asInt() ?? 0) == 2147483647);
}

#[group: "trees"]
test trees_ipv4_every_record_size
{
    array<string> $sizes = ['24', '28', '32'];

    foreach ($sizes as $size) {
        $d = db("MaxMind-DB-test-ipv4-{$size}");

        assert($d->meta->ipVersion == 4);

        Found $one = guard $d->lookup(v4(1, 1, 1, 1));
        Found $two = guard $d->lookup(v4(1, 1, 1, 3));
        Found $mappedTwo = guard $d->lookup(mapped(1, 1, 1, 3));

        assert(($one->entry->get('ip')->asStr() ?? '') == '1.1.1.1');
        assert($one->prefix == 32);
        assert(($two->entry->get('ip')->asStr() ?? '') == '1.1.1.2');
        assert($two->prefix == 31);
        assert($mappedTwo->prefix == 31);

        // an IPv4 tree has nothing for a real IPv6 address
        array<uint16> $g = [1, 0, 0, 0, 0, 0, 0, 1];

        assert($d->lookup(v6($g)) == null);
    }
}

#[group: "trees"]
test trees_ipv6_every_record_size
{
    array<string> $sizes = ['24', '28', '32'];

    foreach ($sizes as $size) {
        $d = db("MaxMind-DB-test-ipv6-{$size}");
        array<uint16> $a = [0, 0, 0, 0, 0, 1, 65535, 65535];
        array<uint16> $b = [0, 0, 0, 0, 0, 2, 0, 1];
        Found $one = guard $d->lookup(v6($a));
        Found $two = guard $d->lookup(v6($b));

        assert(($one->entry->get('ip')->asStr() ?? '') == '::1:ffff:ffff');
        assert($one->prefix == 128);
        assert(($two->entry->get('ip')->asStr() ?? '') == '::2:0:0');
        assert($two->prefix == 122);
        assert($d->lookup(v4(1, 1, 1, 1)) == null);
    }
}

#[group: "trees"]
test trees_mixed
{
    array<string> $sizes = ['24', '32'];

    foreach ($sizes as $size) {
        $d = db("MaxMind-DB-test-mixed-{$size}");
        Found $four = guard $d->lookup(v4(1, 1, 1, 3));
        array<uint16> $g = [0, 0, 0, 0, 0, 2, 0, 1];
        Found $six = guard $d->lookup(v6($g));

        assert(($four->entry->get('ip')->asStr() ?? '') == '::1.1.1.2');
        assert($four->prefix == 31);
        assert(($six->entry->get('ip')->asStr() ?? '') == '::2:0:0');
    }
}
